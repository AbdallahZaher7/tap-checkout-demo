# Environment variables for the Vercel project (Settings -> Environment Variables).
# Tap dashboard -> goSell -> API Credentials. Use TEST keys only. Never commit real values.
TAP_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
TAP_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
TAP_MERCHANT_ID=
# Optional
CURRENCY=EGP
# Where Tap redirects after 3DS. Leave unset to use the site's own address.
# BASE_URL=https://your-project.vercel.app
# Use one fixed Tap customer for every visitor instead of one per browser.
# TAP_CUSTOMER_ID=cus_xxxxxxxx
